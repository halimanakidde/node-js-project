doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title My Database Info
  link(rel='stylesheet' href='/css/tables.css')
  link(link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous")
h2 Furniture Register
table.furnituretable
  tr
    th Furniture Name
    th Image
    th Wood Type
    th Quantity
    th Update 
    th Delete
  if Furniture.length > 0
    each item in Furniture
      tr
        td #{item.furniturename}
        td 
          img(src="/"+item.furnitureimage alt="furniture image" width="150px" height="170px") 
        td #{item.category}
        td #{item.material}
        td #{item.quantity}
        td 
          a.btn.btn-primary.btn-block(href=`/furniture/${item._id}`) Update
        td 
          form(action='/deletefurniture' method='post')
            input(type='hidden' name='id' value=item._id  )
          a.btn.btn-danger.btn-block(type='submit') Delete