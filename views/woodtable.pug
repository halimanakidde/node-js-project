doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title My Database Info
    link(rel='stylesheet' href='/css/tables.css')
  body
    h2 Wood Register
    table.furnituretable
      tr
        th Wood Name
        th Wood Type
        th Wood Color 
        th Measurements 
        th Quality
        th Quantity
        th Unit Price
        th Supplier Name
        th Supplier Contact
        th Warehouse Location
      if wood.length > 0
        each item in wood
          tr
            td #{item.woodName}
            td #{item.woodType}
            td #{item.woodcolor}
            td #{item.measurements}
            td #{item.quality}
            td #{item.quantity}
            td #{item.unitprice}
            td #{item.supplier}
            td #{item.contact}
            td #{item.warehouseLocation}